# Local E2E defaults
# - For local runs, Playwright will auto-start the Next dev server and use this base URL.
# - For CI against a deployed preview/staging, set E2E_BASE_URL to that URL and do NOT start a local server.
E2E_BASE_URL=http://localhost:3000

# Optional (only needed for auth-gated journeys)
# NOTE: This app's auth is SMS-based. If you have a staging environment with a bypass/mock code,
# set these to valid values for that environment.
E2E_CLIENT_PHONE=
E2E_MOCK_SMS_CODE=


